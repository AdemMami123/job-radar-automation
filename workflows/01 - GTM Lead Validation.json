      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.source, MAX(j.first_seen_at) AS last_new\nFROM (VALUES ('remotive'), ('arbeitnow'), ('remoteok')) AS s(source)\nLEFT JOIN jobs j ON j.source = s.source\nGROUP BY s.source\nHAVING MAX(j.first_seen_at) IS NULL OR MAX(j.first_seen_at) < now() - interval '72 hours';",
        "options": {}
