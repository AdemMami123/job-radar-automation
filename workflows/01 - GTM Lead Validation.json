        "jsCode": "const strip = h => (h || '').replace(/<[^>]*>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim();\nconst out = [];\nfor (const item of $input.all()) {\n  for (const j of (item.json.jobs || [])) {\n    out.push({ json: {\n      source: 'remotive', external_id: String(j.id), title: j.title, company: j.company_name,\n      location: j.candidate_required_location || 'Worldwide', remote: true, url: j.url,\n      description: strip(j.description), tags: j.tags || [], posted_at: j.publication_date\n    }});\n  }\n}\nreturn out;"
