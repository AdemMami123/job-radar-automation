      "id": "ce27bb84-72f1-4c83-9714-d524ddddbe00",
      "name": "Load Config",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1296,
        80
      ],
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "nDYbMEFIrK0Fj0XX",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = {};\nfor (const row of $('Load Config').all()) {\n  cfg[row.json.key] = row.json.value;\n}\n\nconst hits = (list = [], text = '') =>\n  list.filter(k => text.includes(k.toLowerCase()));\n\nconst jobs = $('Normalize & Fingerprint').all();\nconst out = [];\n\nfor (const item of jobs) {\n  const j = item.json;\n\n  if (!j.fingerprint) continue;\n\n  const title = (j.title || '').toLowerCase();\n  const text = `${title} ${(j.description || '').toLowerCase()} ${(j.tags || []).join(' ')}`;\n  const b = {};\n\n  if (hits(cfg.target_titles, title).length) b.title_match = 30;\n\n  const stack = hits(cfg.stack_keywords, text).length;\n  if (stack) b.stack_match = Math.min(stack * 5, 25);\n\n  if (/(^|[^a-z])(junior|entry[- ]level|graduate|associate|intern)([^a-z]|$)/.test(text)) {\n    b.junior_friendly = 15;\n  }\n\n  if (\n    hits(cfg.negative_keywords, title).length ||\n    /([5-9]|1[0-9])[+]? (years|yrs)/.test(text)\n  ) {\n    b.seniority_penalty = -40;\n  }\n\n  if (j.remote || hits(cfg.preferred_locations, (j.location || '').toLowerCase()).length) {\n    b.location_fit = 10;\n  }\n\n  if (j.visa_sponsorship) b.visa_or_relocation = 15;\n\n  if (j.posted_at && (Date.now() - new Date(j.posted_at).getTime()) / 864e5 <= 3) {\n    b.fresh = 10;\n  }\n\n  let score = Object.values(b).reduce((a, v) => a + v, 0);\n\n  if ((cfg.blacklist_companies || []).map(c => c.toLowerCase()).includes((j.company || '').toLowerCase())) {\n    score = 0;\n    b.blacklisted = 0;\n  }\n\n  score = Math.max(0, Math.min(100, score));\n\n  out.push({\n    json: {\n      fingerprint: j.fingerprint,\n      score,\n      score_breakdown: JSON.stringify(b),\n      status: score >= 60 ? 'hot' : score >= 35 ? 'queued' : 'ignored'\n    }\n  });\n}\n\nreturn out;"
      },
