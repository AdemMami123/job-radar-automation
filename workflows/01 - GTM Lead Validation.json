      "id": "6e5c5072-dc48-45c1-a319-0008debdf650",
      "name": "Save Score",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1744,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "nDYbMEFIrK0Fj0XX",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst esc = s =>\n  String(s ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/'/g, '&#39;');\n\nconst jobs = $input.all()\n  .map(i => i.json)\n  .filter(j => j.status === 'hot' && j.title && j.url)\n  .sort((a, b) => (Number(b.score) || 0) - (Number(a.score) || 0));\n\nif (jobs.length === 0) {\n  return [{\n    json: {\n      subject: 'Job Radar: No hot matches found',\n      html: '<h2>Job Radar</h2><p>No jobs met the hot-match criteria in this run. Check your scoring configuration or try again after new jobs are collected.</p>'\n    }\n  }];\n}\n\nconst rows = jobs.map(j => {\n  let breakdown = j.score_breakdown || {};\n\n  if (typeof breakdown === 'string') {\n    try {\n      breakdown = JSON.parse(breakdown);\n    } catch {\n      breakdown = {};\n    }\n  }\n\n  const why = Object.entries(breakdown)\n    .map(([key, value]) => `${key}: ${value}`)\n    .join(', ');\n\n  return `<tr>\n    <td>${esc(j.id ?? '—')}</td>\n    <td><b>${esc(j.title)}</b><br>${esc(j.company)} - ${esc(j.location)}</td>\n    <td>${Number(j.score) || 0}</td>\n    <td>${esc(why)}</td>\n    <td><a href=\"${esc(j.url)}\">Open job</a></td>\n  </tr>`;\n}).join('');\n\nconst html = `\n<h2>${jobs.length} hot job match(es)</h2>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\"\nstyle=\"border-collapse:collapse;font-family:Arial,sans-serif\">\n<tr><th>ID</th><th>Job</th><th>Score</th><th>Why</th><th>Link</th></tr>\n${rows}\n</table>\n<p>Review each listing before applying.</p>`;\n\nreturn [{\n  json: {\n    subject: `Job Radar: ${jobs.length} hot match(es)`,\n    html\n  }\n}];"
      },
