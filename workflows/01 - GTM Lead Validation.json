        "jsCode": "const rows = $input.all().map(i => i.json);\nif (!rows.length) return [];\nconst lines = rows.map(r => `${r.source}: last new job ${r.last_new || 'never'}`);\nreturn [{ json: { subject: 'Job Radar: quiet source(s)', text: lines.join(' | ') } }];"
