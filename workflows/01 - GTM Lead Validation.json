      "id": "ab165d24-5651-4356-b9f9-7dd84520504e",
      "name": "Merge Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        640,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const norm = s => (s || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\nconst seen = new Set();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (!j.title || !j.company) continue; // drops error items from failed sources\n\n  const fingerprint = `${norm(j.company)}|${norm(j.title)}|${norm(j.location)}`;\n  if (seen.has(fingerprint)) continue;\n  seen.add(fingerprint);\n\n  const text = `${j.title} ${j.description || ''}`.toLowerCase();\n  const d = j.posted_at ? new Date(j.posted_at) : null;\n\n  out.push({ json: {\n    fingerprint,\n    source: j.source,\n    external_id: j.external_id,\n    title: j.title.trim(),\n    company: j.company.trim(),\n    location: j.location || null,\n    remote: !!j.remote,\n    url: j.url,\n    description: (j.description || '').slice(0, 4000),\n    tags: (j.tags || []).map(t => String(t).toLowerCase()),\n    visa_sponsorship: /visa sponsorship|sponsor(s|ship)? (a )?visa|relocation (support|package|assistance)/.test(text),\n    posted_at: d && !isNaN(d) ? d.toISOString() : null\n  }});\n}\nreturn out;"
      },
